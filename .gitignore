# 模型权重与下载产物。.orig 是归一化类型号之前的原始下载件, 441MB ——
# 超过 GitHub 单文件 100MB 上限, 而且用户自己会从 ModelScope / HF 下载。
models/*.gguf
models/*.gguf.orig
models/*.apk
models/*.part
out/

# 构建产物
engine/build*/
engine/third_party/llama.cpp/
app/build/
app/android/build/
app/android/app/build/
app/android/.kotlin/
**/.cxx/
**/*.so
**/*.a
**/*.xcframework/

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins*
app/ios/Pods/
app/android/local.properties
app/android/.gradle/

# Node —— backend/、site/、tools/shot/ 三处都有
node_modules/

# Cloudflare Worker (backend/ 统计后台 与 site/ 下载页)
**/.wrangler/
**/.dev.vars
backend/.secrets.env
backend/.cf.env

# Python
__pycache__/
*.pyc
.venv/

# 签名密钥 —— 绝对不能进版本库。
# keystore 一旦丢失, 已上架的应用就再也无法发布更新, 必须单独离线备份。
keystore/
app/android/key.properties
*.jks
*.p12
*.keystore

# 编辑器 / 系统
.idea/
.vscode/
Thumbs.db
desktop.ini
